# Copy to .env and fill in. .env is git-ignored; this file is committed.
# On a deployed host, set these in the dashboard instead: there is no .env there.

# Supabase: dashboard > Connect > Session pooler (port 5432). Not "Direct
# connection", which is IPv6 only and unreachable from most hosts.
# If the password has symbols like @ # / : ? then URL-encode them (@ is %40).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Comma-separated, no trailing slash, no path. An origin is scheme + host + port.
CORS_ORIGINS=http://localhost:5173

# Set to production on your host. Express and several libraries behave better,
# including not sending stack traces to your users.
NODE_ENV=development

# Do NOT set PORT locally or on the host. The host sets it for you.

# Signs the login tokens. Anyone who knows it can log in as any user, so it is
# long, random, and never committed. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# On the host, paste a DIFFERENT one into the dashboard than the one you use locally.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING
